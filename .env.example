# Copy this file to .env.local and fill in only the values you use.
# .env.local is ignored by Git and is loaded automatically by the Farming server.

# Required only for Research > YouTube Opportunity Scout.
YOUTUBE_API_KEY=

# Defaults shown below normally work for the local apps.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
DRAW_THINGS_URL=http://localhost:7860

# Optional overrides.
PORT=4000
# FARMING_DATA_DIR=/absolute/path/to/farming-data
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
